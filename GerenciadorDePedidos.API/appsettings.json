{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "AuthLockout": {
    "Enabled": true,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Redis": {
    "Enabled": false,
    "InstancePrefix": "GerenciadorDePedidos:"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "GerenciadorDePedidos",
    "Audience": "ClientesProdutos",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "UseInMemory": false
  }
}
