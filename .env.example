# Ambiente ASP.NET Core (Production por padrão; use Development apenas localmente)
ASPNETCORE_ENVIRONMENT=Production

# Banco de dados MySQL (Docker) - aplicação conecta com usuário de menor privilégio
MYSQL_DATABASE=GerenciadorDePedidos
MYSQL_ROOT_PASSWORD=defina-uma-senha-root-forte
MYSQL_USER=gerenciador_app
MYSQL_PASSWORD=defina-uma-senha-forte-app

# JWT (mínimo 32 bytes / 256 bits)
JWT_KEY=defina-uma-chave-secreta-com-pelo-menos-32-caracteres

# Seed do Administrador inicial (criado automaticamente apenas se não houver Admin no banco)
ADMIN_SEED_NOME=Administrador
ADMIN_SEED_TELEFONE=11999999999
ADMIN_SEED_EMAIL=admin@gerenciador.com
ADMIN_SEED_PASSWORD=DefinaUmaSenhaForte@123

# RabbitMQ (Docker)
RABBITMQ_USER=gerenciador
RABBITMQ_PASS=defina-uma-senha-forte

# Redis (protegido por senha no Docker Compose)
REDIS_PASSWORD=defina-uma-senha-forte-redis
REDIS_CONNECTION=localhost:6379,password=defina-uma-senha-forte-redis

# CORS (origem permitida para o frontend)
CORS_ALLOWED_ORIGIN=https://app.seudominio.com

# OpenTelemetry OTLP (opcional — ex.: http://otel-collector:4317)
OTEL_OTLP_ENDPOINT=
