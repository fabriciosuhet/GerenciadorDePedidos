# Banco de dados MySQL (Docker)
MYSQL_DATABASE=GerenciadorDePedidos
MYSQL_ROOT_PASSWORD=defina-uma-senha-forte

# JWT
JWT_KEY=defina-uma-chave-secreta-com-pelo-menos-32-caracteres

# Seed do Administrador inicial (criado automaticamente apenas se não houver Admin no banco)
ADMIN_SEED_NOME=Administrador
ADMIN_SEED_TELEFONE=11999999999
ADMIN_SEED_EMAIL=admin@gerenciador.com
ADMIN_SEED_PASSWORD=DefinaUmaSenhaForte@123

